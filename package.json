{
  "name": "energy-tracker",
  "version": "1.0.0",
  "description": "In the future this gonna be a website (or a mobile app) focused on watch the best prices of energy drinks",
  "homepage": "https://github.com/melqmarqs/energy-tracker#readme",
  "bugs": {
    "url": "https://github.com/melqmarqs/energy-tracker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/melqmarqs/energy-tracker.git"
  },
  "license": "MIT",
  "author": "",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && next dev",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:start": "docker compose -f infra/compose.yaml start",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "migration:create": "node-pg-migrate --migrations-dir infra/migrations create",
    "migration:up": "node-pg-migrate --migrations-dir infra/migrations --envPath .env.development up",
    "migration:down": "node-pg-migrate --migrations-dir infra/migrations --envPath .env.development down"
  },
  "dependencies": {
    "dotenv": "^16.4.4",
    "next": "^13.1.6",
    "node-pg-migrate": "^6.2.2",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "jest": "^29.6.2",
    "prettier": "^3.9.6"
  }
}
